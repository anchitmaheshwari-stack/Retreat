# Google service account key (raw JSON or base64 of the JSON file).
# Add its client_email as a user on the Search Console property, and share the sheet with it (Viewer).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Search Console property, exactly as listed in GSC
GSC_SITE=sc-domain:skydo.com

# Content Retreat Performance sheet; the tab lists URL, Page Type, Primary Keyword in columns A–C
SHEET_ID=16ViDEvp1WlUTqWOpUwbFohW__oNAIQqG7aER5waMXNY
SHEET_TAB=Sheet1

# First month shown on the dashboard
START_MONTH=2026-08

# Metabase saved question returning leads by landing URL and date
METABASE_URL=https://analytics.skydo.com
METABASE_API_KEY=
METABASE_CARD_ID=
# Optional column overrides if auto-detection picks the wrong columns
# METABASE_URL_COLUMN=
# METABASE_DATE_COLUMN=
# METABASE_LEADS_COLUMN=
# METABASE_ONBOARD_COLUMN=

# Protects /api/refresh; Vercel Cron sends it automatically as a Bearer token
CRON_SECRET=
